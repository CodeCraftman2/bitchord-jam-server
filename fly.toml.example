app = "CHANGE-ME-unique-app-name"
primary_region = "bom"  # pick the closest: fly platform regions

[build]

[env]
  PORT = "8000"
  JAM_TRUST_PROXY = "true"
  JAM_MAX_MEMBERS = "5"
  JAM_PLAY_LEAD_MS = "500"
  JAM_STATE_HEARTBEAT_MS = "5000"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [[http_service.checks]]
    method = "GET"
    path = "/healthz"
    interval = "15s"
    timeout = "3s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
